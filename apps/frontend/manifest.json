{
  "manifest": {
    "manifestVersion": "1.0.0",
    "technicalName": "my-example-erp-plugin",
    "version": "1.0.0",
    "requirements": {
      "minCloudApiVersion": "1.0.0"
    },
    "lifecycle": {
      "configurationUrl": "http://localhost:6142/setup",
      "connectUrl": "http://localhost:6142/connect",
      "disconnectUrl": "http://localhost:6142/disconnect"
    },
    "capabilities": {
      "erp": {
        "menuItems": [
          {
            "id": "Dashboard",
            "name": "Dashboard",
            "url": "http://localhost:6142/erp/menu/Dashboard"
          },
          {
            "id": "ApiDashboard",
            "name": "API Dashboard",
            "url": "http://localhost:6142/erp/menu/ApiDashboard"
          }
        ],
        "api": {
          "scopes": [
            "system.all"
          ]
        },
        "pane": [
          {
            "id": "pane-1",
            "context": "orders",
            "matchChildContext": true,
            "title": "Bestellübersicht",
            "url": "http://localhost:6142/erp/pane/orders",
            "requiredScopes": [
              "orders.read"
            ]
          }
        ]
      }
    }
  },
  "listing": {
    "version": "1.0.0",
    "listingVersion": "1.0.0",
    "defaultLocale": "de-DE",
    "name": {
      "de-DE": {
        "short": "Biber Sample Plugin",
        "full": "Biber Sample Plugin Application"
      }
    },
    "description": {
      "de-DE": {
        "short": "Ein Beispiel-Plugin für das JTL Cloud ERP",
        "full": "Ein Beispiel-Plugin für das JTL Cloud ERP, "
      }
    },
    "benefits": {
      "de-DE": [
        "benefits"
      ]
    },
    "category": {
      "main": "mainCate",
      "sub": [
        "subCate"
      ]
    },
    "media": {
      "icons": {
        "light": "https://imageslot.com/v1/400x400?bg=dd951c&fg=ffffff&shadow=ffffff&text=Demo&filetype=png",
        "dark": "https://imageslot.com/v1/400x400?bg=dd951c&fg=ffffff&shadow=ffffff&text=Demo&filetype=png"
      },
      "screenshots": [
        "https://picsum.photos/200/200"
      ],
      "video": "https://picsum.photos/200/200"
    },
    "pricing": {
      "freePlan": true
    },
    "support": {
      "url": {
        "de-DE": "http://localhost:6142/support"
      },
      "documentation": {
        "de-DE": "https://docs.example.com/user-guide"
      }
    },
    "legal": {
      "privacyPolicy": "http://localhost:6142/privacy",
      "termsOfUse": "http://localhost:6142/terms-of-use",
      "gdpr": {
        "request": "https://example.com/gdpr/data-request",
        "delete": "https://example.com/gdpr/account-deletion"
      }
    },
    "editorial": {
      "status": true
    },
    "distributionType": "PRIVATE",
    "listingVersionStatus": "DRAFT"
  }
}