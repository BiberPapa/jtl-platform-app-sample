{
  "manifest": {
    "manifestVersion": "1.0.0",
    "technicalName": "my-example-app",
    "version": "1.0.0",
    "requirements": {
      "minCloudApiVersion": "1.0.0"
    },
    "lifecycle": {
      "configurationUrl": "https://example.com/configure",
      "connectUrl": "https://example.com/connect",
      "disconnectUrl": "https://example.com/disconnect"
    },
    "capabilities": {
      "hub": {
        "appLauncher": {
          "redirectUrl": "https://example.com/hub/launch",
          "closedPreviewUrl": "https://example.com/hub/preview"
        }
      },
      "erp": {
        "menuItems": [
          {
            "id": "menu-item-1",
            "name": "Mein Menüpunkt",
            "url": "https://example.com/erp/menu"
          }
        ],
        "api": {
          "scopes": ["orders.read", "orders.write", "items.read"]
        },
        "pane": [
          {
            "id": "pane-1",
            "context": "orders",
            "matchChildContext": false,
            "title": "Bestellübersicht",
            "url": "https://example.com/erp/pane/orders",
            "requiredScopes": ["orders.read"]
          }
        ]
      }
    }
  },
  "listing": {
    "version": "1.0.0",
    "listingVersion": "1.0.0",
    "defaultLocale": "de-DE",
    "name": {
      "de-DE": {
        "short": "Meine App",
        "full": "Meine App"
      }
    },
    "description": {
      "de-DE": {
        "short": "Meine App",
        "full": "Meine App"
      }
    },
    "benefits": {
      "de-DE": ["benefits"]
    },
    "category": {
      "main": "mainCate",
      "sub": ["subCate"]
    },
    "media": {
      "icons": {
        "light": "https://picsum.photos/200/200",
        "dark": "https://picsum.photos/200/200"
      },
      "screenshots": ["https://picsum.photos/200/200"],
      "video": "https://picsum.photos/200/200"
    },
    "pricing": {
      "freePlan": true
    },
    "support": {
      "url": {
        "de-DE": "https://support.example.com/tickets"
      },
      "documentation": {
        "de-DE": "https://docs.example.com/user-guide"
      }
    },
    "legal": {
      "privacyPolicy": "https://example.com/legal/privacy",
      "termsOfUse": "https://example.com/legal/terms",
      "gdpr": {
        "request": "https://example.com/gdpr/data-request",
        "delete": "https://example.com/gdpr/account-deletion"
      }
    },
    "editorial": {
      "status": true
    },
    "distributionType": "PRIVATE",
    "listingVersionStatus": "DRAFT"
  }
}
