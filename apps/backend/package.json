{
  "name": "cloud-app-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/assets', 'dist/assets', { recursive: true })\"",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.15.0",
    "supertest": "^7.1.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "jose": "^6.2.1",
    "pino": "9.7.0"
  }
}
