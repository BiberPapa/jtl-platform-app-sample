{
  "manifestVersion": "1.0.0",
  "version": "1.0.0",
  "name": {
    "short": "Cloud App",
    "full": "Cloud App for Demo"
  },
  "description": {
    "short": "Demo app for ERP, setup and pane integrations.",
    "full": "Cloud App demonstrates setup, ERP entry points and pane integrations in a compact example application."
  },
  "defaultLocale": "de-DE",
  "locales": {
    "de-DE": {
      "key1": "abc"
    },
    "en": {
      "key1": "abc"
    }
  },
  "icon": {
    "light": "https://imageslot.com/v1/400x400?bg=dd951c&fg=ffffff&shadow=ffffff&text=Demo&filetype=png",
    "dark": "https://imageslot.com/v1/400x400?bg=dd951c&fg=ffffff&shadow=ffffff&text=Demo&filetype=png"
  },
  "communication": {
    "supportUrl": "http://localhost:50142/support",
    "guideUrl": "https://example.com/guide"
  },
  "legal": {
    "gdprRequestUrl": "https://example.com/gdpr/request",
    "gdprDeleteUrl": "https://example.com/gdpr/delete",
    "privacyUrl": "http://localhost:50142/privacy",
    "termsOfUseUrl": "http://localhost:50142/terms-of-use"
  },
  "lifecycle": {
    "setupUrl": "http://localhost:50142/setup",
    "connectUrl": "https://example.com/lifecycle/connect",
    "disconnectUrl": "https://example.com/lifecycle/disconnect"
  },
  "capabilities": {
    "hub": {
      "appLauncher": {
        "redirectUrl": "http://localhost:50142/hub",
        "closedPreviewUrl": "https://example.com/closed-preview"
      }
    },
    "erp": {
      "headless": {
        "url": "http://localhost:50142/erp"
      },
      "menuItems": [
        {
          "id": "ExamplePage1",
          "name": "Dashboard",
          "url": "http://localhost:50142/erp/menu/ExamplePage1",
          "children": [
            {
              "id": "ExampleGroup1",
              "name": "Customer Insights",
              "children": [
                {
                  "id": "ExamplePage2",
                  "name": "Customer Overview",
                  "url": "http://localhost:50142/erp/menu/ExamplePage2"
                },
                {
                  "id": "ExamplePage3",
                  "name": "Customer Activity",
                  "url": "http://localhost:50142/erp/menu/ExamplePage3"
                }
              ]
            }
          ]
        }
      ],
      "tabs": [
        {
          "context": "productDetail",
          "name": "Product Overview",
          "url": "http://localhost:50142/erp/tabs/ExampleTab1",
          "features": ["details:full", "pricing:write"]
        },
        {
          "context": "customerDetail",
          "name": "Customer Notes",
          "url": "http://localhost:50142/erp/tabs/ExampleTab2",
          "features": ["details:write", "address:read"]
        }
      ],
      "api": {
        "scopes": ["items.read", "items.write"]
      },
      "pane": [
        {
          "context": "$tenantSlug.customers.overview",
          "matchChildContext": false,
          "title": "Customer Overview Pane",
          "url": "http://localhost:50142/pane"
        }
      ]
    }
  }
}
