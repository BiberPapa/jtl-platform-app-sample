{
  "manifestVersion": "1.0.0",
  "version": "1.0.0",
  "name": {
    "short": "Hello World",
    "full": "The official Hello World app for Demo"
  },
  "description": {
    "short": "Lorem ipsum.",
    "full": "Minions ipsum gelatooo uuuhhh para tú bappleees para tú tank yuuu! Gelatooo po kass. Bappleees poopayee tulaliloo pepete belloo! Wiiiii."
  },
  "defaultLocale": "de-DE",
  "locales": {
    "de-DE": {
      "key1": "abc"
    },
    "en": {
      "key1": "abc"
    }
  },
  "icon": {
    "light": "https://i.ibb.co/RkWVbTsG/CODE-LEAP-logo-1024sq-Bach-Tung-Vu.png",
    "dark": "https://i.ibb.co/RkWVbTsG/CODE-LEAP-logo-1024sq-Bach-Tung-Vu.png"
  },
  "communication": {
    "supportUrl": "https://example.com/support-for-app-xy/__ACTIVE_LOCALE__/",
    "guideUrl": "https://example.com/guide-for-app-xy?lang=__ACTIVE_LOCALE__"
  },
  "legal": {
    "gdprRequestUrl": "https://example.com/gdpr/request",
    "gdprDeleteUrl": "https://example.com/gdpr/delete",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms-of-use"
  },
  "lifecycle": {
    "setupUrl": "http://localhost:50142/setup",
    "connectUrl": "http://localhost:50142/lifecycle/connect",
    "disconnectUrl": "http://localhost:50142/lifecycle/disconnect"
  },
  "capabilities": {
    "hub": {
      "appLauncher": {
        "redirectUrl": "http://localhost:50142/erp",
        "closedPreviewUrl": "http://localhost:50142/closed-preview"
      }
    },
    "erp": {
      "headless": {
        "url": "http://localhost:50142/erp"
      },
      "menuItems": [
        {
          "id": "ExamplePage1",
          "name": "ExamplePage1",
          "url": "http://localhost:50142/erp/menu/ExamplePage1",
          "children": [
            {
              "id": "ExampleGroup1",
              "name": "ExampleGroup1",
              "children": [
                {
                  "id": "ExamplePage2",
                  "name": "ExamplePage2",
                  "url": "http://localhost:50142/erp/menu/ExamplePage2"
                },
                {
                  "id": "ExamplePage3",
                  "name": "ExamplePage3",
                  "url": "http://localhost:50142/erp/menu/ExamplePage3"
                }
              ]
            }
          ]
        }
      ],
      "tabs": [
        {
          "context": "productDetail",
          "name": "ExampleTab1",
          "url": "http://localhost:50142/erp/tabs/ExampleTab1",
          "features": ["details:full", "pricing:write"]
        },
        {
          "context": "customerDetail",
          "name": "ExampleTab2",
          "url": "http://localhost:50142/erp/tabs/ExampleTab2",
          "features": ["details:write", "address:read"]
        }
      ],
      "api": {
        "scopes": ["items.read", "items.write"]
      },
      "pane": [
        {
          "context": "$tenantSlug.customers.overview",
          "matchChildContext": false,
          "title": "<PANE TITLE>",
          "url": "http://localhost:50142/pane"
        }
      ]
    }
  }
}
