corepack yarn format:check

# Run focused workspace checks only when the demo app changed.
if git diff --cached --name-only | grep -q '^src/hello-world-app/'; then
  echo "Running hello-world-app quality checks..."
  corepack yarn --cwd src/hello-world-app lint
  corepack yarn --cwd src/hello-world-app typecheck
  corepack yarn --cwd src/hello-world-app test
else
  echo "No staged changes in src/hello-world-app. Skipping workspace checks."
fi
